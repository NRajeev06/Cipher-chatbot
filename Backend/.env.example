# Groq API for Fast Text Chat
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Tavily Search API Key (sign up at https://tavily.com for real-time web search)
TAVILY_API_KEY=""

# Cloud PostgreSQL Database URL (Neon / Supabase)
DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change_this_to_a_secure_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# HuggingFace for Image Generation
HF_TOKEN=your_huggingface_api_token_here
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Brevo (formerly Sendinblue) Email API Settings (Recommended - free tier sends to any recipient)
# Sign up at https://brevo.com and get your API key from SMTP & API Keys dashboard
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_brevo_account_email@example.com

# Resend Email API Settings (HTTP API - alternative/rollback)
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMTP Email Verification Settings (Alternative/Legacy)
# For Gmail: generate an App Password from Google Account Security settings
# (https://myaccount.google.com/apppasswords), NOT your regular Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
FRONTEND_URL=http://localhost:5173

# Rate Limiting Settings
CHAT_RATE_LIMIT=20/minute
IMAGE_RATE_LIMIT=10/hour
UPLOAD_RATE_LIMIT=5/hour
LOGIN_RATE_LIMIT=5/15minutes
SIGNUP_RATE_LIMIT=3/hour
RESEND_RATE_LIMIT=3/hour
